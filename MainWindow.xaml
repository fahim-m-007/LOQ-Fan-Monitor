
<Window x:Class="LOQFanMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/LOQFanMonitor.ico"
        Title="LOQ Fan Monitor"
        Height="720"
        Width="1120"
        MinHeight="650"
        MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="#F4F7FC"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="LOQ FAN MONITOR"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#78A8FF"/>

                <TextBlock Text="Hardware overview"
                           FontSize="30"
                           FontWeight="Bold"
                           Margin="0,5,0,0"/>

                <TextBlock x:Name="StatusText"
                           Text="Connecting to Lenovo telemetry..."
                           Style="{StaticResource SmallLabel}"
                           Margin="0,7,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <Ellipse x:Name="StatusDot"
                         Width="9"
                         Height="9"
                         Fill="#F4B860"
                         Margin="0,0,9,0"/>

                <TextBlock x:Name="UpdatedText"
                           Text="Waiting for first reading"
                           Foreground="#B9C5D8"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="FAN 1"
                               Style="{StaticResource SmallLabel}"/>

                    <TextBlock x:Name="Fan1Text"
                               Text="----"
                               FontSize="42"
                               FontWeight="Bold"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="RPM"
                               Foreground="#78A8FF"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,1,0,0"/>

                    <TextBlock x:Name="Fan1StateText"
                               Text="Waiting for sensor"
                               Style="{StaticResource SmallLabel}"
                               Margin="0,17,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="FAN 2"
                               Style="{StaticResource SmallLabel}"/>

                    <TextBlock x:Name="Fan2Text"
                               Text="----"
                               FontSize="42"
                               FontWeight="Bold"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="RPM"
                               Foreground="#78A8FF"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,1,0,0"/>

                    <TextBlock x:Name="Fan2StateText"
                               Text="Waiting for sensor"
                               Style="{StaticResource SmallLabel}"
                               Margin="0,17,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="TEMPERATURES"
                               Style="{StaticResource SmallLabel}"/>

                    <TextBlock Text="CPU"
                               Foreground="#B9C5D8"
                               Margin="0,14,0,0"/>

                    <TextBlock x:Name="CpuTempText"
                               Text="-- °C"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0"/>

                    <TextBlock Text="GPU"
                               Foreground="#B9C5D8"
                               Margin="0,13,0,0"/>

                    <TextBlock x:Name="GpuTempText"
                               Text="-- °C"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="Fan speed history"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Live RPM readings, updated every second"
                                   Style="{StaticResource SmallLabel}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#4F8CFF"
                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Fan 1"
                                   Foreground="#B9C5D8"
                                   Margin="0,0,16,0"/>

                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#38C99A"
                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Fan 2"
                                   Foreground="#B9C5D8"/>
                    </StackPanel>
                </Grid>

                <Canvas x:Name="HistoryCanvas"
                        Grid.Row="1"
                        Margin="0,22,0,10"
                        ClipToBounds="True"
                        SizeChanged="HistoryCanvas_SizeChanged"/>

                <TextBlock x:Name="HistoryCaption"
                           Grid.Row="2"
                           Text="Collecting readings..."
                           Style="{StaticResource SmallLabel}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="2,18,2,0">
            <TextBlock Text="READ-ONLY MODE  •  Lenovo WMI telemetry"
                       Foreground="#71819B"
                       FontSize="11"
                       VerticalAlignment="Center"/>

            <Button Content="Minimize to tray"
                    HorizontalAlignment="Right"
                    Padding="16,8"
                    Background="#243653"
                    Foreground="White"
                    BorderThickness="0"
                    Click="MinimizeToTray_Click"/>
        </Grid>
    </Grid>
</Window>
