<Window x:Class="LOQFanMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/LOQFanMonitor.ico"
        Title="LOQ Fan Monitor"
        Height="740"
        Width="1120"
        MinHeight="680"
        MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="#F4F7FC"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="InnerPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InnerPanelBrush}"/>
            <Setter Property="BorderBrush" Value="#22304A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style x:Key="PillBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#0E1526"/>
            <Setter Property="BorderBrush" Value="#26334D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="LOQ FAN MONITOR"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#78A8FF"/>

                <TextBlock Text="Hardware Overview"
                           FontSize="30"
                           FontWeight="Bold"
                           Margin="0,4,0,0"/>

                <TextBlock x:Name="StatusText"
                           Text="Connecting to Lenovo telemetry..."
                           Style="{StaticResource SmallLabel}"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#141C2F"
                    BorderBrush="#26334D"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14,7">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot"
                             Width="9"
                             Height="9"
                             Fill="#F4B860"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"/>

                    <TextBlock x:Name="LiveBadgeText"
                               Text="WAITING"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#38C99A"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Middle Telemetry Cards -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <!-- FAN 1 Card -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="FAN 1 (GPU)"
                                   Style="{StaticResource SmallLabel}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <!-- Vector Fan Icon (Blue) -->
                        <Viewbox Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform x:Name="Fan1Rotation" Angle="0"/>
                            </Viewbox.RenderTransform>
                            <Canvas Width="32" Height="32">
                                <Path Stroke="#4F8CFF" StrokeThickness="1.7" Fill="#1A4F8CFF"
                                      Data="M16,13 C16,7 20,3 24,5 C27,7 24,13 19,14 Z
                                            M19,16 C25,16 29,20 27,24 C25,27 19,24 18,19 Z
                                            M16,19 C16,25 12,29 8,27 C5,25 8,19 13,18 Z
                                            M13,16 C7,16 3,12 5,8 C7,5 13,8 14,13 Z"/>
                                <Ellipse Canvas.Left="12.5" Canvas.Top="12.5" Width="7" Height="7"
                                         Stroke="#4F8CFF" StrokeThickness="1.8" Fill="#141C2F"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Fan1Text"
                                       Text="----"
                                       FontSize="40"
                                       FontWeight="Bold"/>
                            <TextBlock Text="RPM"
                                       Foreground="#B9C5D8"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="8,0,0,7"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <TextBlock x:Name="Fan1PercentText"
                                   Text="--%"
                                   Foreground="#4F8CFF"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,2,7"/>
                    </Grid>

                    <!-- Fan 1 Progress Track -->
                    <Border Grid.Row="2"
                            x:Name="Fan1BarTrack"
                            Height="12"
                            CornerRadius="6"
                            Background="{StaticResource TrackBrush}"
                            BorderBrush="#22304A"
                            BorderThickness="1"
                            Margin="0,14,0,0"
                            SizeChanged="GaugeTrack_SizeChanged">
                        <Border x:Name="Fan1BarFill"
                                HorizontalAlignment="Left"
                                Width="0"
                                CornerRadius="5"
                                Background="{StaticResource Fan1BarBrush}"/>
                    </Border>

                    <!-- Fan 1 Avg & Peak Badges -->
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="0,16,0,0">
                        <Border Style="{StaticResource PillBadgeStyle}" Margin="0,0,8,0">
                            <TextBlock x:Name="Fan1AvgText"
                                       Text="Avg: -- RPM"
                                       Foreground="#D6E0F0"
                                       FontSize="12"
                                       FontWeight="Medium"/>
                        </Border>

                        <Border Style="{StaticResource PillBadgeStyle}">
                            <TextBlock x:Name="Fan1PeakText"
                                       Text="Peak: -- RPM"
                                       Foreground="#D6E0F0"
                                       FontSize="12"
                                       FontWeight="Medium"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- FAN 2 Card -->
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="FAN 2 (CPU)"
                                   Style="{StaticResource SmallLabel}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <!-- Vector Fan Icon (Emerald) -->
                        <Viewbox Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform x:Name="Fan2Rotation" Angle="0"/>
                            </Viewbox.RenderTransform>
                            <Canvas Width="32" Height="32">
                                <Path Stroke="#38C99A" StrokeThickness="1.7" Fill="#1A38C99A"
                                      Data="M16,13 C16,7 20,3 24,5 C27,7 24,13 19,14 Z
                                            M19,16 C25,16 29,20 27,24 C25,27 19,24 18,19 Z
                                            M16,19 C16,25 12,29 8,27 C5,25 8,19 13,18 Z
                                            M13,16 C7,16 3,12 5,8 C7,5 13,8 14,13 Z"/>
                                <Ellipse Canvas.Left="12.5" Canvas.Top="12.5" Width="7" Height="7"
                                         Stroke="#38C99A" StrokeThickness="1.8" Fill="#141C2F"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Fan2Text"
                                       Text="----"
                                       FontSize="40"
                                       FontWeight="Bold"/>
                            <TextBlock Text="RPM"
                                       Foreground="#B9C5D8"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="8,0,0,7"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <TextBlock x:Name="Fan2PercentText"
                                   Text="--%"
                                   Foreground="#38C99A"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,2,7"/>
                    </Grid>

                    <!-- Fan 2 Progress Track -->
                    <Border Grid.Row="2"
                            x:Name="Fan2BarTrack"
                            Height="12"
                            CornerRadius="6"
                            Background="{StaticResource TrackBrush}"
                            BorderBrush="#22304A"
                            BorderThickness="1"
                            Margin="0,14,0,0"
                            SizeChanged="GaugeTrack_SizeChanged">
                        <Border x:Name="Fan2BarFill"
                                HorizontalAlignment="Left"
                                Width="0"
                                CornerRadius="5"
                                Background="{StaticResource Fan2BarBrush}"/>
                    </Border>

                    <!-- Fan 2 Avg & Peak Badges -->
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="0,16,0,0">
                        <Border Style="{StaticResource PillBadgeStyle}" Margin="0,0,8,0">
                            <TextBlock x:Name="Fan2AvgText"
                                       Text="Avg: -- RPM"
                                       Foreground="#D6E0F0"
                                       FontSize="12"
                                       FontWeight="Medium"/>
                        </Border>

                        <Border Style="{StaticResource PillBadgeStyle}">
                            <TextBlock x:Name="Fan2PeakText"
                                       Text="Peak: -- RPM"
                                       Foreground="#D6E0F0"
                                       FontSize="12"
                                       FontWeight="Medium"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TEMPERATURES Card -->
            <Border Grid.Column="4" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="TEMPERATURES"
                               Style="{StaticResource SmallLabel}"
                               FontWeight="SemiBold"/>

                    <!-- CPU Sub-Panel -->
                    <Border Grid.Row="2" Style="{StaticResource InnerPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="CPU"
                                           Foreground="#B9C5D8"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#0E1526"
                                            BorderBrush="#26334D"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="8,2"
                                            Margin="0,0,6,0">
                                        <TextBlock x:Name="CpuAvgText"
                                                   Text="Avg: -- °C"
                                                   Foreground="#D6E0F0"
                                                   FontSize="11"
                                                   FontWeight="Medium"/>
                                    </Border>

                                    <Border Background="#0E1526"
                                            BorderBrush="#26334D"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="8,2">
                                        <TextBlock x:Name="CpuPeakText"
                                                   Text="Peak: -- °C"
                                                   Foreground="#D6E0F0"
                                                   FontSize="11"
                                                   FontWeight="Medium"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="CpuTempText"
                                           Grid.Column="0"
                                           Text="-- °C"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <Border Grid.Column="1"
                                        x:Name="CpuBarTrack"
                                        Height="10"
                                        CornerRadius="5"
                                        Background="{StaticResource TrackBrush}"
                                        BorderBrush="#22304A"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0"
                                        SizeChanged="GaugeTrack_SizeChanged">
                                    <Border x:Name="CpuBarFill"
                                            HorizontalAlignment="Left"
                                            Width="0"
                                            CornerRadius="4"
                                            Background="{StaticResource Fan2BarBrush}"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- GPU Sub-Panel -->
                    <Border Grid.Row="4" Style="{StaticResource InnerPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="GPU"
                                           Foreground="#B9C5D8"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#0E1526"
                                            BorderBrush="#26334D"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="8,2"
                                            Margin="0,0,6,0">
                                        <TextBlock x:Name="GpuAvgText"
                                                   Text="Avg: -- °C"
                                                   Foreground="#D6E0F0"
                                                   FontSize="11"
                                                   FontWeight="Medium"/>
                                    </Border>

                                    <Border Background="#0E1526"
                                            BorderBrush="#26334D"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="8,2">
                                        <TextBlock x:Name="GpuPeakText"
                                                   Text="Peak: -- °C"
                                                   Foreground="#D6E0F0"
                                                   FontSize="11"
                                                   FontWeight="Medium"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="GpuTempText"
                                           Grid.Column="0"
                                           Text="-- °C"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <Border Grid.Column="1"
                                        x:Name="GpuBarTrack"
                                        Height="10"
                                        CornerRadius="5"
                                        Background="{StaticResource TrackBrush}"
                                        BorderBrush="#22304A"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0"
                                        SizeChanged="GaugeTrack_SizeChanged">
                                    <Border x:Name="GpuBarFill"
                                            HorizontalAlignment="Left"
                                            Width="0"
                                            CornerRadius="4"
                                            Background="{StaticResource Fan2BarBrush}"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Fan Speed History Card -->
        <Border Grid.Row="4" Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="Fan speed history"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Rolling 180s window • 1s interval"
                                   Style="{StaticResource SmallLabel}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Ellipse Width="9"
                                 Height="9"
                                 Fill="#4F8CFF"
                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Fan 1"
                                   Foreground="#D6E0F0"
                                   FontWeight="Medium"
                                   Margin="0,0,18,0"/>

                        <Ellipse Width="9"
                                 Height="9"
                                 Fill="#38C99A"
                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Fan 2"
                                   Foreground="#D6E0F0"
                                   FontWeight="Medium"/>
                    </StackPanel>
                </Grid>

                <Canvas x:Name="HistoryCanvas"
                        Grid.Row="1"
                        Margin="0,20,0,4"
                        ClipToBounds="True"
                        SizeChanged="HistoryCanvas_SizeChanged"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="2,16,2,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="READ-ONLY MODE"
                           Foreground="#5C8DFF"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <TextBlock Text="  •  Lenovo WMI Telemetry   |   "
                           Foreground="#8292AA"
                           FontSize="12"/>
                <TextBlock x:Name="HistoryCaption"
                           Text="Session: 0 seconds"
                           Foreground="#91A0B8"
                           FontSize="12"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
