<Application x:Class="LOQFanMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="BackgroundColor">#0B1020</Color>
        <Color x:Key="PanelColor">#141C2F</Color>
        <Color x:Key="InnerPanelColor">#19243B</Color>
        <Color x:Key="PanelBorderColor">#26334D</Color>
        <Color x:Key="TrackColor">#0E1526</Color>
        <Color x:Key="AccentColor">#4F8CFF</Color>
        <Color x:Key="Fan2Color">#38C99A</Color>
        <Color x:Key="MutedColor">#91A0B8</Color>

        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="InnerPanelBrush" Color="{StaticResource InnerPanelColor}"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorderColor}"/>
        <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="Fan2Brush" Color="{StaticResource Fan2Color}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>

        <LinearGradientBrush x:Key="Fan1BarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3B73E6" Offset="0"/>
            <GradientStop Color="#66A3FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Fan2BarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#23A87D" Offset="0"/>
            <GradientStop Color="#49E2B1" Offset="1"/>
        </LinearGradientBrush>
    </Application.Resources>
</Application>
